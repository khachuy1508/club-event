# Neon Postgres (required for local + production)
# Dashboard → Connection string → use "Pooled" for Vercel serverless
# Example: postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"
QR_SECRET="replace-with-another-long-random-string"

# Local
NEXTAUTH_URL="http://localhost:3000"
# Production — MUST include https://
# NEXTAUTH_URL="https://club-event-three.vercel.app"
# AUTH_URL="https://club-event-three.vercel.app"

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  CLUB_STAFF
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  studentId    String?  @unique
  name         String
  major        String?
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clubStaff   ClubStaff?
  checkIns    CheckIn[]  @relation("StudentCheckIns")
  checkedInBy CheckIn[]  @relation("StaffCheckIns")
  vote        Vote?
  opinion     Opinion?
}

model Club {
  id        String   @id @default(cuid())
  name      String
  nameVi    String
  nameEn    String
  code      String?
  slug      String   @unique
  sortOrder Int      @default(0)
  logoMime  String?
  logoBytes Bytes?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff    ClubStaff[]
  checkIns CheckIn[]
  votes    Vote[]
}

model ClubStaff {
  id     String @id @default(cuid())
  userId String @unique
  clubId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model CheckIn {
  id            String   @id @default(cuid())
  studentId     String
  clubId        String
  checkedInById String
  createdAt     DateTime @default(now())

  student     User @relation("StudentCheckIns", fields: [studentId], references: [id], onDelete: Cascade)
  club        Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  checkedInBy User @relation("StaffCheckIns", fields: [checkedInById], references: [id])

  @@unique([studentId, clubId])
  @@index([clubId])
  @@index([studentId])
}

model Vote {
  id        String   @id @default(cuid())
  studentId String   @unique
  clubId    String
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  club    Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model Opinion {
  id        String   @id @default(cuid())
  studentId String   @unique
  body      String
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

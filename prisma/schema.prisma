generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  CLUB_STAFF
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  studentId    String?  @unique
  name         String
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clubStaff    ClubStaff?
  checkIns     CheckIn[] @relation("StudentCheckIns")
  checkedInBy  CheckIn[] @relation("StaffCheckIns")
  vote         Vote?
}

model Club {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff    ClubStaff?
  checkIns CheckIn[]
  votes    Vote[]
}

model ClubStaff {
  id     String @id @default(cuid())
  userId String @unique
  clubId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id            String   @id @default(cuid())
  studentId     String
  clubId        String
  checkedInById String
  createdAt     DateTime @default(now())

  student   User @relation("StudentCheckIns", fields: [studentId], references: [id], onDelete: Cascade)
  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  checkedInBy User @relation("StaffCheckIns", fields: [checkedInById], references: [id])

  @@unique([studentId, clubId])
  @@index([clubId])
  @@index([studentId])
}

model Vote {
  id        String   @id @default(cuid())
  studentId String   @unique
  clubId    String
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  club    Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}
